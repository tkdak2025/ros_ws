<?xml version="1.0"?>
<package format="3">
  <name>cable_inspection</name>
  <version>0.1.0</version>
  <description>Independent CCCIS robot control and inspection nodes</description>
  <maintainer email="tkdak2025@gmail.com">hun</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>cable_interfaces</depend>
  <depend>rosidl_runtime_py</depend>
  <depend>ament_index_python</depend>
  <depend>dsr_msgs2</depend>
  <depend>onrobot_rg_msgs</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <!-- Optional robot_bringup.launch.py uses the external hardware drivers. -->
  <exec_depend>dsr_bringup2</exec_depend>
  <exec_depend>onrobot_rg_control</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
