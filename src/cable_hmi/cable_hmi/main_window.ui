  </property>
  <property name="minimumSize">
   <size>
    <width>1000</width>
    <height>740</height>
   </size>
  </property>
  <property name="windowTitle">
   <string>케이블 체결 검사 HMI</string>
  </property>
  <property name="styleSheet">
   <string>QWidget { font-family: 'Noto Sans CJK KR', 'NanumGothic', sans-serif; font-size: 13px; color: #2B3440; }
QMainWindow, #root { background: #F2F4F7; }

QFrame[role=&quot;panel&quot;] { background: #FFFFFF; border: 1px solid #D9E0E7; border-radius: 6px; }
QFrame[role=&quot;subPanel&quot;] { background: #F8FAFC; border: 1px solid #E1E7EE; border-radius: 6px; }
QLabel[role=&quot;groupTitle&quot;] { font-weight: bold; }
QLabel[role=&quot;key&quot;] { color: #5B6675; }
QLabel[role=&quot;value&quot;] { font-weight: bold; }
QLabel[role=&quot;panelTitle&quot;] { background: #168DB5; color: #FFFFFF; font-size: 14px; font-weight: bold;
    border-top-left-radius: 6px; border-top-right-radius: 6px; padding: 7px 12px; }
#sidebarTitle { font-size: 15px; font-weight: bold; }

#header { background: #2E92BD; border-radius: 6px; padding: 0 14px; }
#headerTitle { color: #FFFFFF; font-size: 17px; font-weight: bold; }
#stateBadge { background: rgba(255,255,255,0.18); color: #FFFFFF; font-weight: bold;
    border-radius: 10px; padding: 3px 12px; }

#chipTotal, #chipPass, #chipMissing, #chipFail { font-weight: bold; border-radius: 10px; padding: 3px 12px; }
#chipTotal { background: #EEF1F5; color: #8A94A3; }
#chipPass { background: #E6F7EE; color: #1E8E5A; }
#chipMissing { background: #FFF0D8; color: #B7791F; }
#chipFail { background: #FFE8EA; color: #D12F3A; }

QPushButton { border: none; border-radius: 8px; font-size: 15px; font-weight: bold; color: #FFFFFF; padding: 6px 10px; }
#startBtn { background: #379DD3; }
#startBtn:hover { background: #2C8BC0; }
#pauseBtn { background: #B9B96A; }
#pauseBtn:hover { background: #A8A858; }
#resumeBtn { background: #8584C6; }
#resumeBtn:hover { background: #7372B5; }
#estopBtn { background: #E31C24; border: 4px solid #9E1116; border-radius: 38px; font-size: 16px; }
#estopBtn:hover { background: #C9151C; }
#estopBtn:pressed { background: #9E1116; }
#estopResetBtn { background: #FFFFFF; color: #D12F3A; border: 1px solid #D12F3A; font-size: 12px;
    padding: 3px 8px; border-radius: 6px; }
#failBtn, #missingBtn { background: #8FA3A6; }
#failBtn:hover, #missingBtn:hover { background: #7C9194; }
#homeBtn { background: #FFFFFF; color: #2B3440; border: 1px solid #9AA5B1; }
#homeBtn:hover { background: #EEF2F6; }
#exportBtn { background: #FFFFFF; color: #2B3440; border: 1px solid #9AA5B1; font-size: 12px;
    padding: 3px 10px; border-radius: 6px; }
#exportBtn:hover { background: #EEF2F6; }
#exportBtn:disabled { background: #F2F4F7; color: #B5BDC7; border: 1px solid #D9E0E7; }
/* ID 선택자가 QPushButton:disabled 보다 우선하므로 버튼마다 :disabled 를 따로 둔다 */
#startBtn:disabled, #pauseBtn:disabled, #resumeBtn:disabled, #failBtn:disabled, #missingBtn:disabled {
    background: #D5DBE3; color: #F5F7FA; }
#homeBtn:disabled, #estopResetBtn:disabled { background: #F2F4F7; color: #B5BDC7; border: 1px solid #D9E0E7; }

QComboBox { background: #FFFFFF; border: 1px solid #C5CED8; border-radius: 4px; padding: 3px 8px; min-width: 110px; }
QComboBox#recipeCombo { min-width: 160px; }
QTabWidget::pane { border: 1px solid #D9E0E7; border-radius: 4px; top: -1px; }
QTabBar::tab { background: #F2F4F7; border: 1px solid #D9E0E7; padding: 5px 14px;
    border-top-left-radius: 4px; border-top-right-radius: 4px; }
QTabBar::tab:selected { background: #FFFFFF; border-bottom-color: #FFFFFF; font-weight: bold; }
QTableWidget { border: none; gridline-color: #E8EDF2; selection-background-color: #CFE6F3; selection-color: #2B3440; }
QHeaderView::section { background: #E6F0F5; border: none; padding: 5px; font-weight: bold; }
QPlainTextEdit { border: none; background: #FFFFFF; font-size: 12px; }

QSlider::groove:horizontal { height: 8px; background: #D9E0E7; border-radius: 4px; }
QSlider::sub-page:horizontal { background: #379DD3; border-radius: 4px; }
QSlider::handle:horizontal { background: #379DD3; width: 22px; margin: -7px 0; border-radius: 11px; }
QSlider::handle:horizontal:disabled, QSlider::sub-page:horizontal:disabled { background: #B5BDC7; }
QProgressBar { background: #E4E9EF; border: none; border-radius: 5px; max-height: 10px; }
QProgressBar::chunk { background: #2699B3; border-radius: 5px; }
</string>
