<ui version="4.0"><class>ResultDetailDialog</class><widget class="QDialog" name="ResultDetailDialog"><property name="geometry"><rect><x>0</x><y>0</y><width>560</width><height>520</height></rect></property><property name="minimumSize"><size><width>560</width><height>0</height></size></property><property name="windowTitle"><string>검사 결과 상세</string></property><property name="styleSheet"><string notr="true">/* main_window.ui 의 스타일 중 상세창이 쓰는 규칙을 복사한 것이다.
   Designer 에서 이 파일만 열어도 실제와 같은 모양으로 보이게 하기 위해서다.
   HMI 에서는 메인 창의 스타일도 함께 적용되며, 겹치면 여기 적힌 것이 우선한다. */
QWidget { font-family: 'Noto Sans CJK KR', 'NanumGothic', sans-serif; font-size: 13px; color: #2B3440; }
QFrame[role="subPanel"] { background: #F8FAFC; border: 1px solid #E1E7EE; border-radius: 6px; }
QLabel[role="groupTitle"] { font-weight: bold; }
QLabel[role="key"] { color: #5B6675; }
QLabel[role="value"] { font-weight: bold; }
QLabel[role="colHead"] { color: #5B6675; font-size: 12px; }
QLabel[role="panelTitle"] { background: #168DB5; color: #FFFFFF; font-size: 14px; font-weight: bold;
    border-top-left-radius: 6px; border-top-right-radius: 6px; padding: 7px 12px; }
#headTitle { font-size: 16px; font-weight: bold; }
#headSub { color: #5B6675; }
#badge { background: #EEF1F5; color: #8A94A3; font-weight: bold; font-size: 18px;
    border-radius: 10px; padding: 3px 12px; }
#whyLabel { font-size: 14px; font-weight: bold; border-radius: 6px; padding: 10px 12px;
    background: #EEF1F5; color: #2B3440; }
#detailsBtn { background: transparent; color: #5B6675; border: none; text-align: left; padding: 4px 0; }
#detailsBtn:hover { color: #168DB5; }
